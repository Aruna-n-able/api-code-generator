# ──────────────────────────────────────────────────────────────────────────────
# API Code Generator — environment variables
#
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically when python-dotenv is installed.
# It is git-ignored so secrets are never committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0

# ── GitHub access (required to browse the private nable-nc/api-service repo) ──
#
# Create a Personal Access Token at https://github.com/settings/tokens
# The token needs only read-only repository access:
#   • Classic token:       select the "repo" scope
#   • Fine-grained token:  grant "Contents: Read" on the nable-nc organisation
#
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── AI provider (optional — only needed for AI refinement features) ────────────
# Leave blank to use Ollama (local, free, no key required).
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
